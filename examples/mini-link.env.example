MINI_LINK_NAME=WPitombeira
MINI_LINK_TITLE=WPitombeira links
MINI_LINK_BIO=Builder, AI systems, automation
MINI_LINK_AVATAR=WP
# MINI_LINK_AVATAR_URL=https://cdn.example.com/avatar.png
MINI_LINK_BASE_URL=https://wpitombeira.com.br
MINI_LINK_TEMPLATE=glass
MINI_LINK_ACCENT=#0f766e
MINI_LINK_FOOTER=Open source, MIT licensed, built with Go.
MINI_LINK_CACHE_SECONDS=300
# Favicon source priority during export:
# 1. MINI_LINK_FAVICON_SOURCE_URL or MINI_LINK_FAVICON_SOURCE_PATH
# 2. MINI_LINK_AVATAR_URL
# 3. generated initials SVG
# MINI_LINK_FAVICON_SOURCE_URL=https://cdn.example.com/avatar.png
# MINI_LINK_FAVICON_SOURCE_PATH=./assets/avatar.png
# Optional S3-compatible upload for generated favicon assets.
# Cloudflare Pages and Workers Static Assets usually do not need this; keep assets in dist/.
# MINI_LINK_ASSET_UPLOAD_PROVIDER=r2
# MINI_LINK_ASSET_UPLOAD_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# MINI_LINK_ASSET_UPLOAD_BUCKET=mini-link-assets
# MINI_LINK_ASSET_UPLOAD_ACCESS_KEY_ID=...
# MINI_LINK_ASSET_UPLOAD_SECRET_ACCESS_KEY=...
# MINI_LINK_ASSET_UPLOAD_PUBLIC_BASE_URL=https://assets.example.com
# MINI_LINK_ASSET_UPLOAD_PREFIX=mini-link
# Optional Google Ads tag. Leave unset to keep Mini-Link JavaScript-free.
# MINI_LINK_GOOGLE_ADS_ID=AW-123456789
# MINI_LINK_CUSTOM_ICONS_JSON=[{"name":"sparkle","label":"Sparkle","view_box":"0 0 24 24","path":"M12 2 15 9 22 12 15 15 12 22 9 15 2 12 9 9Z"}]
MINI_LINK_LINK_1_TITLE=Mini-Link
MINI_LINK_LINK_1_URL=https://github.com/WPitombeira/mini-link
MINI_LINK_LINK_1_ICON=code
MINI_LINK_LINK_1_FEATURED=true
MINI_LINK_LINK_2_TITLE=GitHub
MINI_LINK_LINK_2_URL=https://github.com/WPitombeira
MINI_LINK_LINK_2_ICON=github
MINI_LINK_LINK_3_TITLE=LinkedIn
MINI_LINK_LINK_3_URL=https://www.linkedin.com/
MINI_LINK_LINK_3_ICON=linkedin
MINI_LINK_LINK_4_TITLE=Website
MINI_LINK_LINK_4_URL=https://wpitombeira.com.br
MINI_LINK_LINK_4_ICON=globe
MINI_LINK_LINK_5_TITLE=Projects
MINI_LINK_LINK_5_URL=https://github.com/WPitombeira?tab=repositories
MINI_LINK_LINK_5_ICON=code
MINI_LINK_LINK_6_TITLE=Contact
MINI_LINK_LINK_6_URL=mailto:hello@wpitombeira.com.br
MINI_LINK_LINK_6_ICON=contact

# For dropdowns in env-based deployments, use MINI_LINK_LINKS_JSON instead of numbered links.
# MINI_LINK_LINKS_JSON=[{"title":"Projects","icon":"briefcase","open":true,"links":[{"title":"Mini-Link","url":"https://github.com/WPitombeira/mini-link","icon":"github"}]}]
# For one-off external icons, use MINI_LINK_LINK_1_ICON_URL=https://cdn.example.com/icon.svg.
